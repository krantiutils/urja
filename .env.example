# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=urja
DB_PASSWORD=urja_secret
DB_NAME=urja
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# OTP
OTP_EXPIRY=5m
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN=60s
OTP_HOURLY_LIMIT=5
BCRYPT_COST=12

# Dev OTP Bypass (E2E testing only — NEVER enable in production)
# DEV_OTP_BYPASS=false

# Aakash SMS
AAKASH_SMS_TOKEN=your_aakash_sms_token_here
AAKASH_SMS_API_URL=https://sms.aakashsms.com/sms/v3/send

# S3 / MinIO (File Storage)
S3_ENDPOINT=localhost:9000
S3_BUCKET=urja
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_USE_SSL=false

# Firebase Cloud Messaging (Push Notifications)
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Khalti Payment
KHALTI_SECRET_KEY=your_khalti_secret_key_here
KHALTI_PUBLIC_KEY=your_khalti_public_key_here
